# 로컬 개발용 — 이 파일을 .env로 복사해서 사용하세요
# 서버 배포 시에는 provision 과정에서 자동으로 설정됩니다

PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASS=mypassword

# Naver Cloud Platform — Maps API (서버측 호출용)
# console.ncloud.com 의 Application 등록 후 발급받습니다.
# Web Dynamic Map(클라이언트용 ncpKeyId) 과는 별도의 자격증명입니다.
NAVER_MAPS_CLIENT_ID=        # 프론트엔드 JS SDK용 (ncpKeyId)
NAVER_NCP_API_KEY_ID=        # X-NCP-APIGW-API-KEY-ID (서버측 Geocode/Directions)
NAVER_NCP_API_KEY=           # X-NCP-APIGW-API-KEY (서버측 Geocode/Directions)
KAKAO_MAPS_APP_KEY=          # (선택) Kakao JS SDK 키

# 공공데이터포털 인증키 (경찰청 교차로 API)
# data.go.kr 마이페이지 > 인증키 발급현황의 "일반 인증키(Decoding)" 값을 넣는다.
# 계정당 키는 하나이고 데이터셋별로 활용신청 승인만 갈리므로, 아래 키 하나로
#   - 경찰청_교차로기반정보서비스 (신호등 위치)
#   - 경찰청_교차로계획정보서비스 (신호 주기)  ※ 별도 활용신청 필요
# 를 모두 사용한다. 승인 전에는 SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 난다.
DATA_GO_KR_SERVICE_KEY=

# 신호 주기용으로만 다른 계정 키를 쓸 때만 채운다 (비우면 위 키를 그대로 사용).
DATA_GO_KR_PLAN_SERVICE_KEY=
